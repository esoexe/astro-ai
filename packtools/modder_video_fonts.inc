inline std::string b64(const EmbeddedFile& e) {
    std::string out; out.reserve(e.size);
    unsigned v = 0; int bits = 0;
    for (std::size_t i = 0; i < e.n; ++i) for (const char* p = e.parts[i]; *p; ++p) {
