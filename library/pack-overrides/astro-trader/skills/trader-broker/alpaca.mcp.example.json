{
  "mcpServers": {
    "alpaca": {
      "command": "uvx",
      "args": ["alpaca-mcp-server"],
      "env": {
        "ALPACA_API_KEY": "TYPE_YOUR_PAPER_KEY_IN_ASTRO_MCP_SETTINGS_NEVER_IN_CHAT",
        "ALPACA_SECRET_KEY": "TYPE_YOUR_PAPER_SECRET_IN_ASTRO_MCP_SETTINGS_NEVER_IN_CHAT",
        "ALPACA_PAPER_TRADE": "true",
        "ALPACA_TOOLSETS": "account,trading,stock-data"
      }
    }
  }
}
