<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is needed for the engine inside the phone (127.0.0.1) and for "Connect to my PC" on your own
     network (192.168.x.x and similar addresses, which cannot be listed here). The app's single network layer
     (net/Api.kt, checkUrl) refuses plain http to anything that is not loopback or a private network address,
     so everything on the internet still goes over https. The built-in engine uses its own TLS (curl + OpenSSL). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
