<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="astro_bg">#0A0A0C</color>
    <color name="astro_accent">#F3A679</color>
    <style name="AstroTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/astro_bg</item>
        <item name="android:colorAccent">@color/astro_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
