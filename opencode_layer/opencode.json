{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "lsp": false,
  "formatter": false,
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny"
  },
  "tools": {
    "*": false
  },
  "agent": {
    "chat": {
      "mode": "primary",
      "description": "Plain chat for Workspace: no tools, no file or shell access.",
      "tools": {
        "*": false
      },
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny"
      },
      "prompt": "You are Workspace, a helpful general assistant. Follow the system instructions you are given."
    }
  },
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local (llama.cpp)",
      "options": {
        "baseURL": "http://127.0.0.1:8081/v1"
      },
      "models": {
        "qwen2.5-1.5b-instruct": {
          "name": "Qwen 2.5 1.5B (local)",
          "limit": {
            "context": 4096,
            "output": 768
          }
        }
      }
    }
  },
  "small_model": "local/qwen2.5-1.5b-instruct"
}