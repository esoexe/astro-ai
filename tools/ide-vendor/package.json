{
  "name": "astro-ide-vendor",
  "private": true,
  "version": "1.0.0",
  "description": "Builds web/vendor/ide.js (CodeMirror 6 + xterm.js) and three.js ES modules for the Astro AI Workspace. Run: npm install && npm run build",
  "scripts": {
    "build": "esbuild src.js --bundle --minify --format=iife --global-name=AstroIDE --target=es2019 --outfile=../../web/vendor/ide.js --legal-comments=none && cp node_modules/@xterm/xterm/css/xterm.css ../../web/vendor/xterm.css && npm run three",
    "three": "echo \"export * from 'three';\" > .three-entry.mjs && esbuild .three-entry.mjs --bundle --minify --format=esm --target=es2020 --legal-comments=none --outfile=../../web/vendor/three.module.min.js && esbuild node_modules/three/examples/jsm/controls/OrbitControls.js --bundle --minify --format=esm --target=es2020 --external:three --legal-comments=none --outfile=../../web/vendor/OrbitControls.js && rm -f .three-entry.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "three": "^0.186.1"
  }
}