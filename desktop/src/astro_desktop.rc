// Windows resources for the A.S.T.R.O AI desktop launcher.
#include <winver.h>
#include "astro_version.h"   /* written by desktop/package.sh from VER */
// 1 = icon Explorer shows for the .exe; 32512 (IDI_APPLICATION) = icon webview loads for the window.
1 ICON "../assets/astro.ico"
32512 ICON "../assets/astro.ico"
1 24 "astro_desktop.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ASTRO_VER_NUM
PRODUCTVERSION ASTRO_VER_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "A.S.T.R.O AI"
      VALUE "FileDescription", "A.S.T.R.O AI desktop"
      VALUE "FileVersion", ASTRO_VER_STR
      VALUE "ProductName", "A.S.T.R.O AI"
      VALUE "ProductVersion", ASTRO_VER_STR
      VALUE "OriginalFilename", "AstroAI.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
