// Windows resources for the Astro AI desktop launcher.
#include <winver.h>
// 1 = icon Explorer shows for the .exe; 32512 (IDI_APPLICATION) = icon webview loads for the window.
1 ICON "../assets/astro.ico"
32512 ICON "../assets/astro.ico"
1 24 "astro_desktop.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,4,0,0
PRODUCTVERSION 1,4,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Astro AI"
      VALUE "FileDescription", "Astro AI desktop"
      VALUE "FileVersion", "1.4.0"
      VALUE "ProductName", "Astro AI"
      VALUE "ProductVersion", "1.4.0"
      VALUE "OriginalFilename", "AstroAI.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
