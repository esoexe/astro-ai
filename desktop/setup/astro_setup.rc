// Resources for the A.S.T.R.O AI installer. edition.h (generated by build_setup.sh) supplies names and paths.
#include <winver.h>
#include "setup_ids.h"
#include "edition.h"
LANGUAGE 0, 0
IDI_APP          ICON    SETUP_ICON
1                24      "astro_setup.manifest"
#ifdef WITH_PAYLOAD
IDR_PAYLOAD      RCDATA  SETUP_PAYLOAD
IDR_WV2          RCDATA  SETUP_WV2
#endif
IDR_FONT_SANS    RCDATA  "fonts/Inter-Regular.ttf"
IDR_FONT_SEMI    RCDATA  "fonts/Inter-SemiBold.ttf"
IDR_FONT_SERIF   RCDATA  "fonts/InstrumentSerif-Regular.ttf"
IDR_FONT_SERIF_I RCDATA  "fonts/InstrumentSerif-Italic.ttf"
IDR_FONT_MONO    RCDATA  "fonts/JetBrainsMono-Regular.ttf"
IDR_LOGO         RCDATA  SETUP_LOGO

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION_NUM
PRODUCTVERSION APP_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "A.S.T.R.O AI"
      VALUE "FileDescription", APP_DISPLAY_A " Setup"
      VALUE "FileVersion", APP_VERSION_A
      VALUE "ProductName", "A.S.T.R.O AI"
      VALUE "ProductVersion", APP_VERSION_A
      VALUE "LegalCopyright", "A.S.T.R.O AI"
      VALUE "OriginalFilename", "Setup.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
